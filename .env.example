# Copy this file to .env and fill it in. Never commit the real .env.
#
# This file is the single source of truth for credentials. The setup script
# reads accounts from here and registers them with Claude Desktop without
# copying any passwords into the client config.

# ---------------------------------------------------------------------------
# Your main account
# ---------------------------------------------------------------------------
IMAP_HOST=mail.yourdomain.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=you@yourdomain.com
IMAP_PASS=your-mailbox-password
# If your password contains a '#', write it base64 encoded instead, because a
# '#' starts a comment in this file format and would truncate it silently:
#   IMAP_PASS_B64=eW91ci1wYXNzd29yZA==
# 'npm start' does this for you automatically.

SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@yourdomain.com
SMTP_PASS=your-mailbox-password

# ---------------------------------------------------------------------------
# Additional accounts (optional)
#
# List their names here, comma separated, then define each one below using the
# name in UPPERCASE as a prefix. The example below defines a mailbox named
# "support", which appears in Claude Desktop as the connector "mail-support".
# ---------------------------------------------------------------------------
# ACCOUNTS=support

# SUPPORT_IMAP_HOST=mail.yourdomain.com
# SUPPORT_IMAP_USER=you@yourdomain.com
# SUPPORT_IMAP_PASS=other-password
# SUPPORT_SMTP_HOST=mail.yourdomain.com
# SUPPORT_SMTP_USER=you@yourdomain.com
# SUPPORT_SMTP_PASS=other-password

# ---------------------------------------------------------------------------
# Optional settings. Prefix them per account the same way.
# ---------------------------------------------------------------------------
# Address in the From header. Defaults to SMTP_USER.
# FROM_ADDRESS=you@yourdomain.com

# Save a copy of sent mail to the Sent folder over IMAP. Most self-hosted and
# cPanel servers do not do this for you.
# SAVE_TO_SENT=true

# Only set false for a known certificate mismatch, understanding the risk.
# TLS_REJECT_UNAUTHORIZED=true

# How long to hold the IMAP connection open between calls, in ms.
# IDLE_TIMEOUT_MS=60000
